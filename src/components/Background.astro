---
/**
 * 背景层 + 全站交互脚本
 * 包含：LiDAR 激光雷达点云与 SLAM 空间特征网络交互背景、科技 HUD 扫描线、鼠标光晕与全局入场动效
 * 放在 Layout 里，所有页面共用；transition:persist 让它在页面切换时不重建。
 */
import { theme } from "@/data/resume";

const heroImage = theme.heroImage;
---

<div class="bg" aria-hidden="true" transition:persist="site-bg">
  {
    heroImage && (
      <div class="bg-image" id="bg-image" style={`background-image:url(${heroImage})`} />
    )
  }
  <!-- 空间感知点云 / 神经图谱 Canvas -->
  <canvas id="bg-canvas" class="bg-canvas"></canvas>
  
  <!-- 科技光斑与雷达激光扫描层 -->
  <div class="bg-aurora">
    <span class="blob blob-1"></span>
    <span class="blob blob-2"></span>
  </div>
  <div class="bg-scanline"></div>
  <div class="bg-grid"></div>
  <div class="bg-noise"></div>
  <div class="bg-scrim"></div>
</div>

<div class="cursor-glow" id="cursor-glow" aria-hidden="true" transition:persist="site-glow"></div>
<div class="progress-bar" id="progress-bar" aria-hidden="true" transition:persist="site-progress"></div>

<script>
  const reduceMotion = () =>
    !!window.matchMedia?.("(prefers-reduced-motion: reduce)").matches;

  /* ---------- 滚动联动：顶栏收窄 + 进度条 ---------- */
  function onScroll() {
    const root = document.documentElement;
    const y = window.scrollY || root.scrollTop || 0;
    const vh = window.innerHeight || 1;

    document
      .getElementById("site-header")
      ?.classList.toggle("scrolled", y > 12);

    const bar = document.getElementById("progress-bar");
    if (bar) {
      const h = document.documentElement.scrollHeight - vh;
      bar.style.transform = `scaleX(${h > 0 ? Math.min(1, y / h) : 0})`;
    }
  }

  /* ---------- 鼠标光晕 ---------- */
  let glowTarget = { x: 0, y: 0 };
  let glowPos = { x: 0, y: 0 };
  let glowRunning = false;
  function glowLoop() {
    const glow = document.getElementById("cursor-glow");
    if (!glow) {
      glowRunning = false;
      return;
    }
    glowPos.x += (glowTarget.x - glowPos.x) * 0.14;
    glowPos.y += (glowTarget.y - glowPos.y) * 0.14;
    glow.style.transform = `translate3d(${glowPos.x.toFixed(1)}px,${glowPos.y.toFixed(1)}px,0)`;
    if (
      Math.abs(glowTarget.x - glowPos.x) < 0.4 &&
      Math.abs(glowTarget.y - glowPos.y) < 0.4
    ) {
      glowRunning = false;
      return;
    }
    requestAnimationFrame(glowLoop);
  }

  /* ---------- LiDAR 空间感知点云与 SLAM 特征 Canvas 动效 ---------- */
  interface Point {
    x: number;
    y: number;
    vx: number;
    vy: number;
    radius: number;
    alpha: number;
    pulse: number;
    pulseSpeed: number;
    isKeypoint: boolean;
  }

  let canvasAnimId: number | null = null;
  function initLidarCanvas() {
    const canvas = document.getElementById("bg-canvas") as HTMLCanvasElement | null;
    if (!canvas) return;
    const ctx = canvas.getContext("2d");
    if (!ctx) return;

    if (canvasAnimId) {
      cancelAnimationFrame(canvasAnimId);
      canvasAnimId = null;
    }

    let width = 0;
    let height = 0;
    let dpr = 1;

    function resize() {
      if (!canvas) return;
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      width = window.innerWidth;
      height = window.innerHeight;
      canvas.width = Math.floor(width * dpr);
      canvas.height = Math.floor(height * dpr);
      canvas.style.width = `${width}px`;
      canvas.style.height = `${height}px`;
      ctx?.scale(dpr, dpr);
    }
    resize();

    // 根据屏幕宽度自适应粒子密度
    const count = Math.min(Math.floor((width * height) / 22000), 55);
    const points: Point[] = [];

    for (let i = 0; i < count; i++) {
      points.push({
        x: Math.random() * width,
        y: Math.random() * height,
        vx: (Math.random() - 0.5) * 0.42,
        vy: (Math.random() - 0.5) * 0.42,
        radius: Math.random() * 1.8 + 1.2,
        alpha: Math.random() * 0.5 + 0.25,
        pulse: Math.random() * Math.PI,
        pulseSpeed: 0.02 + Math.random() * 0.03,
        isKeypoint: i % 8 === 0,
      });
    }

    const mouse = { x: -1000, y: -1000, active: false };
    const onPointerMove = (e: PointerEvent) => {
      mouse.x = e.clientX;
      mouse.y = e.clientY;
      mouse.active = true;
    };
    const onPointerLeave = () => {
      mouse.active = false;
      mouse.x = -1000;
      mouse.y = -1000;
    };

    window.addEventListener("pointermove", onPointerMove, { passive: true });
    document.addEventListener("pointerleave", onPointerLeave, { passive: true });

    let isDark = document.documentElement.dataset.theme !== "light";
    const observer = new MutationObserver(() => {
      isDark = document.documentElement.dataset.theme !== "light";
    });
    observer.observe(document.documentElement, { attributes: true, attributeFilter: ["data-theme"] });

    const maxDist = 118;
    const sensorRadius = 155;

    function draw() {
      if (!ctx || !canvas) return;
      ctx.clearRect(0, 0, width, height);

      // 色彩模式：深色模式为赛博青绿与电光蓝，浅色为科技靛蓝
      const r = isDark ? 0 : 37;
      const g = isDark ? 229 : 99;
      const b = isDark ? 255 : 235;

      // 1. 绘制粒子
      for (let i = 0; i < points.length; i++) {
        const p = points[i];

        // 运动更新
        p.x += p.vx;
        p.y += p.vy;

        // 边界弹性回弹
        if (p.x < 0) { p.x = 0; p.vx *= -1; }
        else if (p.x > width) { p.x = width; p.vx *= -1; }
        if (p.y < 0) { p.y = 0; p.vy *= -1; }
        else if (p.y > height) { p.y = height; p.vy *= -1; }

        // 鼠标感知力场（类似机器人避障与雷达视锥交互）
        if (mouse.active) {
          const dx = p.x - mouse.x;
          const dy = p.y - mouse.y;
          const dist = Math.sqrt(dx * dx + dy * dy);
          if (dist < sensorRadius && dist > 1) {
            const force = (1 - dist / sensorRadius) * 0.7;
            p.x += (dx / dist) * force;
            p.y += (dy / dist) * force;

            // 绘制鼠标与近处特征点的连线
            ctx.beginPath();
            ctx.moveTo(mouse.x, mouse.y);
            ctx.lineTo(p.x, p.y);
            ctx.strokeStyle = `rgba(${r}, ${g}, ${b}, ${((1 - dist / sensorRadius) * 0.22).toFixed(3)})`;
            ctx.lineWidth = 0.8;
            ctx.stroke();
          }
        }

        p.pulse += p.pulseSpeed;
        const currentAlpha = p.alpha + Math.sin(p.pulse) * 0.15;

        // 绘制特征点
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(${r}, ${g}, ${b}, ${Math.max(0.1, currentAlpha).toFixed(2)})`;
        ctx.fill();

        // SLAM 关键特征点外圈雷达脉冲
        if (p.isKeypoint) {
          const ringRadius = p.radius + 3.5 + Math.sin(p.pulse) * 2;
          ctx.beginPath();
          ctx.arc(p.x, p.y, Math.max(1, ringRadius), 0, Math.PI * 2);
          ctx.strokeStyle = `rgba(${r}, ${g}, ${b}, ${(Math.max(0, currentAlpha) * 0.35).toFixed(2)})`;
          ctx.lineWidth = 0.75;
          ctx.stroke();
        }
      }

      // 2. 绘制点间感知连线
      for (let i = 0; i < points.length; i++) {
        for (let j = i + 1; j < points.length; j++) {
          const p1 = points[i];
          const p2 = points[j];
          const dx = p1.x - p2.x;
          const dy = p1.y - p2.y;
          const dist = Math.sqrt(dx * dx + dy * dy);

          if (dist < maxDist) {
            const alpha = (1 - dist / maxDist) * (isDark ? 0.22 : 0.15);
            ctx.beginPath();
            ctx.moveTo(p1.x, p1.y);
            ctx.lineTo(p2.x, p2.y);
            ctx.strokeStyle = `rgba(${r}, ${g}, ${b}, ${alpha.toFixed(3)})`;
            ctx.lineWidth = 0.65;
            ctx.stroke();
          }
        }
      }

      canvasAnimId = requestAnimationFrame(draw);
    }

    if (!reduceMotion()) {
      draw();
    } else {
      draw(); // 仅渲染一帧静态图
      if (canvasAnimId) cancelAnimationFrame(canvasAnimId);
    }

    window.addEventListener("resize", resize, { passive: true });

    // 页面不可见时暂停动画以节约性能与功耗
    document.addEventListener("visibilitychange", () => {
      if (document.hidden) {
        if (canvasAnimId) cancelAnimationFrame(canvasAnimId);
      } else if (!reduceMotion()) {
        draw();
      }
    });
  }

  /* ---------- 入场动画 ---------- */
  let io: IntersectionObserver | null = null;
  function setupReveal() {
    const nodes = document.querySelectorAll<HTMLElement>(".reveal");
    const revealAll = () =>
      nodes.forEach(n => n.classList.add("is-visible"));

    if (reduceMotion() || !("IntersectionObserver" in window)) {
      revealAll();
      return;
    }

    const vh = window.innerHeight || 0;
    nodes.forEach(n => {
      const r = n.getBoundingClientRect();
      if (r.top < vh * 0.92 && r.bottom > 0) n.classList.add("is-visible");
    });

    io?.disconnect();
    io = new IntersectionObserver(
      entries => {
        entries.forEach(en => {
          if (en.isIntersecting) {
            en.target.classList.add("is-visible");
            io?.unobserve(en.target);
          }
        });
      },
      { rootMargin: "0px 0px -6% 0px", threshold: 0.05 }
    );

    document.documentElement.classList.add("anim");
    nodes.forEach((n, i) => {
      if (n.classList.contains("is-visible")) return;
      n.style.transitionDelay = `${Math.min(i % 6, 5) * 55}ms`;
      io?.observe(n);
    });

    const sweep = setInterval(() => {
      const h = window.innerHeight || 0;
      let pending = 0;
      document
        .querySelectorAll<HTMLElement>(".reveal:not(.is-visible)")
        .forEach(n => {
          const r = n.getBoundingClientRect();
          if (r.top < h * 0.94 && r.bottom > 0) n.classList.add("is-visible");
          else pending++;
        });
      if (!pending) clearInterval(sweep);
    }, 1200);
    setTimeout(() => clearInterval(sweep), 60000);
    window.addEventListener("beforeprint", revealAll);
  }

  /* ---------- 一键复制反馈 ---------- */
  function initCopy() {
    document.addEventListener(
      "click",
      e => {
        const btn = (e.target as HTMLElement)?.closest?.(".copy-btn");
        if (!btn) return;
        const text = btn.getAttribute("data-copy") || "";
        const done = () => {
          const t = document.createElement("div");
          t.className = "site-toast";
          t.innerHTML = `<span class="toast-dot"></span><span>已复制到剪贴板：${text}</span>`;
          document.body.appendChild(t);
          requestAnimationFrame(() => t.classList.add("show"));
          setTimeout(() => {
            t.classList.remove("show");
            setTimeout(() => t.remove(), 320);
          }, 2000);
        };
        navigator.clipboard?.writeText(text).then(done, done);
      },
      { once: false }
    );
  }

  let started = false;
  function setup() {
    if (!started) {
      started = true;
      window.addEventListener("scroll", onScroll, { passive: true });
      window.addEventListener("resize", onScroll, { passive: true });
      initCopy();
      initLidarCanvas();

      if (
        !reduceMotion() &&
        window.matchMedia?.("(hover: hover) and (pointer: fine)").matches
      ) {
        document.body.classList.add("has-cursor");
        window.addEventListener(
          "pointermove",
          e => {
            glowTarget = { x: e.clientX, y: e.clientY };
            if (!glowRunning) {
              glowRunning = true;
              requestAnimationFrame(glowLoop);
            }
          },
          { passive: true }
        );
      }
    } else {
      initLidarCanvas();
    }
    onScroll();
    setupReveal();
  }

  document.addEventListener("astro:page-load", setup);
</script>

<style>
  .site-toast {
    position: fixed;
    left: 50%;
    bottom: 32px;
    z-index: 100;
    transform: translate(-50%, 18px);
    opacity: 0;
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 10px 20px;
    border-radius: 999px;
    border: 1px solid var(--accent);
    background: var(--card-hover);
    -webkit-backdrop-filter: blur(20px);
    backdrop-filter: blur(20px);
    color: var(--foreground);
    font-size: 13.5px;
    box-shadow: 0 10px 30px -10px rgba(var(--accent-rgb), 0.5);
    transition: all 0.35s var(--ease-out);
  }
  .site-toast.show {
    transform: translate(-50%, 0);
    opacity: 1;
  }
  :global(.toast-dot) {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #00e5ff;
    box-shadow: 0 0 8px #00e5ff;
  }
</style>
